\@writefile{lot}{\contentsline {table}{\numberline {3.1}{\ignorespaces Center wavelengths (nm) of the 25 Ximea spectral bands by position within the repeating 5$\times $5 mosaic tile that covers the sensor array.\relax }}{20}{table.caption.5}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {3.2}{\ignorespaces Principal attributes of the three orchards used in this work. The first two are the primary image-collection sites: the Pittsburgh block supplies the detector's annotated training and validation data, while the Virginia block was collected but left unannotated. The Penn State block is used only to test the full system; its image-set count excludes the ZED2i stream.\relax }}{28}{table.caption.11}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {3.3}{\ignorespaces Composition of the annotated dataset by split. Instance counts are given per symptom class, with the canker share of instances in parentheses. The registered NIR dataset shares the same image membership, splits, and class balance.\relax }}{33}{table.caption.15}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {3.4}{\ignorespaces Symptom types defined in the annotation protocol. The four canker subtypes were later merged into a single \emph  {canker} class for training and evaluation.\relax }}{36}{table.caption.17}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {3.5}{\ignorespaces Class-agnostic accuracy and human correction workload of the cross-modal label transfer pipeline, evaluated on 1{,}231 frames (1{,}632 ground-truth, 1{,}788 predicted boxes) at three IoU thresholds. Mean IoU is computed over matched pairs only; \emph  {add} and \emph  {delete} counts are threshold-independent by construction.\relax }}{40}{table.caption.20}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {3.6}{\ignorespaces Detector training configuration. Settings are shared across modalities except where the RGB and NIR columns differ.\relax }}{43}{table.caption.22}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {3.7}{\ignorespaces Detection performance of the RGB and NIR YOLO26-L-seg models on the validation and held-out test splits. Max-F1 is the peak score over confidence, reported with the confidence threshold at which it occurs.\relax }}{43}{table.caption.23}\protected@file@percent }
